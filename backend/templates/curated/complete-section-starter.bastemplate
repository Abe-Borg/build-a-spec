            "title": "SUMMARY",
            "seq": 4,
            "paragraphs": [
              {
                "id": "pt1.a1.p1",
                "label": "A.",
                "text": "Provide labor, materials, coordination, testing, and documentation necessary for a complete installation within this Section's scope.",
                "status": "imported",
                "source_item_id": "",
                "seq": 3,
                "children": [
                  {
                    "id": "pt1.a1.p1.p1",
                    "label": "1.",
                    "text": "Coordinate interfaces with adjacent systems before fabrication or procurement.",
                    "status": "imported",
                    "source_item_id": "",
                    "seq": 3,
                    "children": [
                      {
                        "id": "pt1.a1.p1.p1.p1",
                        "label": "a.",
                        "text": "Record conflicts and proposed resolutions in the coordination submittal.",
                        "status": "imported",
                        "source_item_id": "",
                        "seq": 2,
                        "children": [
                          {
                            "id": "pt1.a1.p1.p1.p1.p1",
                            "label": "1)",
                            "text": "Identify the responsible party and required decision date for each unresolved interface.",
                            "status": "imported",
                            "source_item_id": "",
                            "seq": 1,
                            "children": []
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "pt1.a1.p1.p2",
                    "label": "2.",
                    "text": "Do not conceal work until required inspections and tests are complete.",
                    "status": "imported",
                    "source_item_id": "",
                    "seq": 1,
                    "children": []
                  }
                ]
              },
              {
                "id": "pt1.a1.p2",
                "label": "B.",
                "text": "Related requirements are specified in adjoining technical sections and the Contract Documents.",
                "status": "imported",
                "source_item_id": "",
                "seq": 1,
                "children": []
              },
              {
                "id": "pt1.a1.p3",
                "label": "C.",
                "text": "Confirm the final limits of work for [TBD: coordinated project scope].",
                "status": "needs_input",
                "source_item_id": "",
                "seq": 1,
                "children": []
              }
            ]
          },
          {
            "id": "pt1.a2",
            "number": "1.2",
            "title": "SUBMITTALS",
            "seq": 3,
            "paragraphs": [
              {
                "id": "pt1.a2.p1",
                "label": "A.",
                "text": "Submit product data, shop drawings, and coordination information appropriate to the selected system.",
                "status": "imported",
                "source_item_id": "",
                "seq": 1,
                "children": []
              },
              {
                "id": "pt1.a2.p2",
                "label": "B.",
                "text": "Submit closeout records identifying installed products, test results, and accepted deviations.",
                "status": "imported",
                "source_item_id": "",
                "seq": 1,
                "children": []
              }
            ]
          },
          {
            "id": "pt1.a3",
            "number": "1.3",
            "title": "QUALITY ASSURANCE",
            "seq": 2,
            "paragraphs": [
              {
                "id": "pt1.a3.p1",
                "label": "A.",
                "text": "Use qualified installers and testing personnel experienced with work of comparable type and complexity.",
                "status": "imported",
                "source_item_id": "",
                "seq": 1,
                "children": []
              }
            ]
          }
