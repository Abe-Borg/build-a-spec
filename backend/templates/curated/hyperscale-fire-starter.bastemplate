          {"id": "pt3.a1.p1", "label": "A.", "text": "Install components to maintain access, drainage, seismic clearances, and coordination with other building systems.", "status": "imported", "source_item_id": "", "seq": 1, "children": []},
          {"id": "pt3.a1.p2", "label": "B.", "text": "Flush, test, inspect, and document the completed system before turnover.", "status": "imported", "source_item_id": "", "seq": 1, "children": []}
