          {"id": "pt2.a1.p1", "label": "A.", "text": "Provide listed pipe, fittings, valves, sprinklers, supervisory devices, and accessories compatible with the selected system.", "status": "imported", "source_item_id": "", "seq": 1, "children": []},
          {"id": "pt2.a1.p2", "label": "B.", "text": "Provide corrosion protection and environmental ratings appropriate to each installed location.", "status": "imported", "source_item_id": "", "seq": 1, "children": []}
        ]}
      ]},
      {"id": "pt3", "number": 3, "title": "PART 3 - EXECUTION", "seq": 2, "articles": [
