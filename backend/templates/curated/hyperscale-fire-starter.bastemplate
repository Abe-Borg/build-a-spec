          {"id": "pt1.a1.p1", "label": "A.", "text": "Provide a complete wet-pipe automatic sprinkler system coordinated with the building fire-protection design.", "status": "imported", "source_item_id": "", "seq": 1, "children": []},
          {"id": "pt1.a1.p2", "label": "B.", "text": "Coordinate system zoning, monitoring interfaces, and impairment planning with related work.", "status": "imported", "source_item_id": "", "seq": 1, "children": []}
        ]},
